<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VortexEditor.Controls"
             xmlns:vp="clr-namespace:VortexEditor.Viewport"
             x:Class="VortexEditor.Panels.ViewportPanel">
  <DockPanel>
    <!-- viewport toolbar: one row while it fits; when the panel is narrow (side panels open) the view controls move to a
         second row instead of running under the next panel -->
    <Border DockPanel.Dock="Top" x:Name="Toolbar" MinHeight="34" Background="{DynamicResource VxToolbarBrush}" Classes="hairline-bottom" Padding="8,0">
      <c:ResponsiveToolbar x:Name="ToolbarLayout" RowHeight="34" Gap="12">
        <WrapPanel x:Name="ToolGroup" Orientation="Horizontal" ItemSpacing="6" VerticalAlignment="Center">
          <Border Classes="segmented">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ToolMove" GroupName="tool" ToolTip.Tip="Move tool (W)" Click="OnToolMove"><c:VxIcon Icon="Move"/></RadioButton>
              <RadioButton x:Name="ToolRotate" GroupName="tool" ToolTip.Tip="Rotate tool (E)" Click="OnToolRotate"><c:VxIcon Icon="Rotate"/></RadioButton>
              <RadioButton x:Name="ToolScale" GroupName="tool" ToolTip.Tip="Scale tool (R)" Click="OnToolScale"><c:VxIcon Icon="Scale"/></RadioButton>
            </StackPanel>
          </Border>
          <ToggleButton x:Name="SpaceToggle" ToolTip.Tip="Local / World space (X)" Click="OnSpaceToggle" Padding="8,2" MinWidth="52"><TextBlock x:Name="SpaceText" Text="World" FontSize="11"/></ToggleButton>
          <Rectangle Width="1" Height="18" Fill="{DynamicResource VxSeparatorBrush}" Margin="4,0"/>
          <ToggleButton x:Name="GridToggle" Classes="icon" ToolTip.Tip="Grid (G)" Click="OnGridToggle"><c:VxIcon Icon="Grid"/></ToggleButton>
          <ToggleButton x:Name="SnapToggle" Classes="icon" ToolTip.Tip="Snap to grid — right-click: snap size" Click="OnSnapToggle" PointerPressed="OnSnapPressed"><c:VxIcon Icon="Snap"/></ToggleButton>
          <ToggleButton x:Name="GizmoToggle" Classes="icon" ToolTip.Tip="Gizmos" Click="OnGizmoToggle"><c:VxIcon Icon="Gizmo"/></ToggleButton>
          <ToggleButton x:Name="ColliderToggle" Classes="icon" ToolTip.Tip="Show collision (green net = solid, amber = trigger) — right-click: all colliders" Click="OnColliderToggle" PointerPressed="OnColliderPressed"><c:VxIcon Icon="Collider"/></ToggleButton>
          <ToggleButton x:Name="FpToggle" Classes="icon" ToolTip.Tip="First-person layer (render layer 1): hidden / in the world / as the game shows it" Click="OnFpToggle"><c:VxIcon Icon="Crosshair"/></ToggleButton>
          <ToggleButton x:Name="FxToggle" Classes="icon" ToolTip.Tip="Post effects (FX): the scene's colour grade, bloom, FXAA, vignette, grain and aberration in this viewport — while building and while playing here. Remembered; off = a faster frame. The game window and the standalone player always apply them." Click="OnFxToggle"><c:VxIcon Icon="Sparkle"/></ToggleButton>
          <Button x:Name="TerrainToolsButton" Classes="icon" ToolTip.Tip="Terrain Tools — create, import or generate a terrain, sculpt and paint it (Window ▸ Terrain Tools…)" Click="OnTerrainTools"><c:VxIcon Icon="World"/></Button>
          <Button x:Name="ViewOptionsButton" Classes="icon" ToolTip.Tip="View options — shading, snap size, camera speed" Click="OnViewOptions"><c:VxIcon Icon="More"/></Button>
        </WrapPanel>
        <WrapPanel x:Name="ViewGroup" Orientation="Horizontal" ItemSpacing="6" VerticalAlignment="Center">
          <Border Classes="segmented">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="LayoutSingle" GroupName="layout" IsChecked="True" ToolTip.Tip="Single view" Click="OnLayoutClick" Tag="1"><c:VxIcon Icon="LayoutSingle"/></RadioButton>
              <RadioButton x:Name="LayoutSplitV" GroupName="layout" ToolTip.Tip="Split vertical (left / right)" Click="OnLayoutClick" Tag="2"><c:VxIcon Icon="LayoutSplitV"/></RadioButton>
              <RadioButton x:Name="LayoutSplitH" GroupName="layout" ToolTip.Tip="Split horizontal (top / bottom)" Click="OnLayoutClick" Tag="3"><c:VxIcon Icon="LayoutSplitH"/></RadioButton>
              <RadioButton x:Name="LayoutQuad" GroupName="layout" ToolTip.Tip="Quad view (2 × 2)" Click="OnLayoutClick" Tag="4"><c:VxIcon Icon="LayoutQuad"/></RadioButton>
            </StackPanel>
          </Border>
          <ComboBox x:Name="CameraSelector" MinWidth="150" SelectionChanged="OnCameraSelected" ToolTip.Tip="View: free camera, a scene camera or the in-game first-person preview"/>
          <ToggleButton x:Name="PipToggle" Classes="icon" ToolTip.Tip="Camera preview (picture in picture)" Click="OnPipToggle"><c:VxIcon Icon="Pip"/></ToggleButton>
        </WrapPanel>
        <StackPanel x:Name="BadgeGroup" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border x:Name="WireBadge" Classes="badge" IsVisible="False" Background="{DynamicResource VxControlBrush}"><TextBlock Text="WIREFRAME"/></Border>
          <Border x:Name="GameViewBadge" Classes="badge" IsVisible="False" Background="{DynamicResource VxPanelRaisedBrush}"><TextBlock Text="GAME VIEW · press ▶" Foreground="{DynamicResource VxTextSecondaryBrush}"/></Border>
          <Border x:Name="FlyBadge" Classes="badge" IsVisible="False" Background="{DynamicResource VxAccentSoftBrush}"><TextBlock x:Name="FlyText" Text="FLY" Foreground="{DynamicResource VxAccentBrush}"/></Border>
          <Border x:Name="PlayBadge" Classes="badge" IsVisible="False" Background="{DynamicResource VxGreenBrush}"><TextBlock Text="PLAY MODE" Foreground="White"/></Border>
          <Border x:Name="ExternalBadge" Classes="badge" IsVisible="False" Background="{DynamicResource VxOrangeBrush}"><TextBlock Text="RUNS IN PLAYER WINDOW" Foreground="White"/></Border>
        </StackPanel>
      </c:ResponsiveToolbar>
    </Border>
    <!-- render surface + optional secondary views -->
    <Grid x:Name="ViewGrid" Background="{DynamicResource VxViewportBgBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
      <Grid x:Name="MainCell">
        <vp:EngineViewport x:Name="Engine"/>
      </Grid>
      <Border x:Name="Cell2" Grid.Column="1" Classes="hairline-left" IsVisible="False"><ContentControl x:Name="Secondary1"/></Border>
      <Border x:Name="Cell3" Grid.Row="1" Classes="hairline-top" IsVisible="False"><ContentControl x:Name="Secondary2"/></Border>
      <Border x:Name="Cell4" Grid.Row="1" Grid.Column="1" Classes="hairline-top hairline-left" IsVisible="False"><ContentControl x:Name="Secondary3"/></Border>
    </Grid>
  </DockPanel>
</UserControl>
